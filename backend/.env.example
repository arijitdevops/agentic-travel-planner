# ---------------------------------------------------------------------------
# Agentic Travel Planner - backend configuration
# Copy to backend/.env and fill in. Every value has a sensible default.
# ---------------------------------------------------------------------------

# Google Gemini (required for AI planning; search & booking work without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.4
AGENT_MAX_ITER=8
CREW_VERBOSE=false

# Database. MySQL 8 (recommended) or SQLite for a quick local run:
#   DATABASE_URL=sqlite:///./travel_planner.db
DATABASE_URL=mysql+pymysql://travel:travel@localhost:3306/travel_planner?charset=utf8mb4
SEED_ON_STARTUP=true

# Web search: DuckDuckGo is used when TAVILY_API_KEY is empty
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# Flights: "local" mock inventory (default) or "duffel" (test-mode token recommended)
FLIGHT_PROVIDER=local
DUFFEL_ACCESS_TOKEN=
OFFER_TTL_MINUTES=30

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Identity used when the client sends no X-User-Email header
DEMO_USER_EMAIL=demo@travelplanner.local
DEMO_USER_NAME=Demo Traveler
